# Copy this file to .env on the VPS and replace placeholder values.

N8N_VERSION=2.38.7
N8N_HOST=n8n.example.com
N8N_BIND_PORT=5678

N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app

GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka
N8N_LOG_LEVEL=info

# Execution pruning: 336 hours = 14 days.
N8N_EXECUTIONS_DATA_MAX_AGE=336
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
