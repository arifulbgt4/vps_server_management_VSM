# Copy this file to .env on the VPS and replace placeholder values.

N8N_VERSION=2.38.7
N8N_HOST=n8n.example.com
N8N_BIND_PORT=5678

N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app

# Dedicated Redis ACL user for the n8n Bull queue.
# Password stays in secrets/redis_password, never in this file.
N8N_REDIS_USER=n8n_queue
N8N_REDIS_DB=1
N8N_QUEUE_PREFIX=n8n

# One worker starts with five concurrent jobs. Increase only after observing CPU,
# RAM, PostgreSQL connection usage, and workflow latency.
N8N_WORKER_CONCURRENCY=5

GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka
N8N_LOG_LEVEL=info

# Execution pruning: 336 hours = 14 days.
N8N_EXECUTIONS_DATA_MAX_AGE=336
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
