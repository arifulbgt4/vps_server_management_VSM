MEDIA_DB_NAME=media_service
MEDIA_DB_USER=media_app
MEDIA_BIND_PORT=8082

# Public URL used only when a file is uploaded with visibility=public.
MEDIA_PUBLIC_BASE_URL=https://media.example.com
MEDIA_PUBLIC_FILES_ENABLED=true

# Per-file hard cap. User storage quota is configured independently in Platform Admin.
MEDIA_MAX_UPLOAD_BYTES=536870912

# Keep at least 5 GiB free on the host filesystem used by /srv.
MEDIA_MIN_FREE_BYTES=5368709120

# false = only the built-in image/video/audio/document/archive MIME allowlist.
MEDIA_ALLOW_OTHER_FILES=false

MEDIA_DB_POOL_MAX=10
