# VSM one-command deployment configuration.
# Copy to .env only when overriding defaults. Secrets are generated at runtime under /srv/vsm/secrets.

TZ=Asia/Dhaka
BASE_DOMAIN=openmusk.store
ADMIN_DOMAIN=admin.openmusk.store
CUSTOMER_DOMAIN=app.openmusk.store
SUPER_ADMIN_DOMAIN=saas-admin.openmusk.store
N8N_DOMAIN=n8n.openmusk.store
MEDIA_DOMAIN=media.openmusk.store
API_DOMAIN=api.openmusk.store
POSTGRES_DOMAIN=db.openmusk.store
REDIS_DOMAIN=redis.openmusk.store
MYSQL_DOMAIN=mysql.openmusk.store
MONGO_DOMAIN=mongo.openmusk.store
ACME_EMAIL=admin@openmusk.store
PUBLIC_IPV4=
ACME_STAGING=false

ADMIN_USERNAME=admin
# Leave blank to generate a strong initial password at first boot.
# VSM_ADMIN_PASSWORD is only used when no persisted admin_password_hash exists.
# Changing it later does NOT change an existing Platform Admin password.
# See docs/PLATFORM_ADMIN_ACCESS.md for username/password retrieval and reset commands.
VSM_ADMIN_PASSWORD=

POSTGRES_VERSION=17-alpine
PGVECTOR_VERSION=0.8.6
REDIS_VERSION=7.4-alpine
MYSQL_VERSION=8.4
MONGO_VERSION=8.0
HAPROXY_VERSION=3.2-alpine
NGINX_VERSION=1.27-alpine
N8N_VERSION=2.38.7
CERTBOT_VERSION=latest

POSTGRES_PUBLIC_PORT=5432
REDIS_PUBLIC_PORT=6380
MYSQL_PUBLIC_PORT=3306
MONGO_PUBLIC_PORT=27017

N8N_WORKER_CONCURRENCY=5
N8N_LOG_LEVEL=info
N8N_EXECUTIONS_DATA_MAX_AGE=336
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
MEDIA_MAX_UPLOAD_BYTES=536870912
MEDIA_MIN_FREE_BYTES=5368709120

POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1536m
REDIS_CPUS=0.50
REDIS_MEMORY=512m
MYSQL_CPUS=1.0
MYSQL_MEMORY=2g
MONGO_CPUS=1.0
MONGO_MEMORY=2g
PLATFORM_ADMIN_CPUS=0.75
PLATFORM_ADMIN_MEMORY=768m
N8N_CPUS=1.0
N8N_MEMORY=1536m
N8N_WORKER_CPUS=1.0
N8N_WORKER_MEMORY=2g
MEDIA_CPUS=0.50
MEDIA_MEMORY=768m

CERTBOT_RENEW_INTERVAL_SECONDS=43200
SMOKE_EXTERNAL_STRICT=false

# n8n-automation SaaS services
AUTOMATION_REPOSITORY=https://github.com/arifulbgt4/n8n-automation.git
AUTOMATION_REF=master
AUTOMATION_IMAGE_TAG=local
AUTOMATION_QUEUE_PREFIX=n8nauto:production
AUTOMATION_CUSTOMER_APP_ORIGIN=https://app.openmusk.store
AUTOMATION_ADMIN_APP_ORIGIN=https://saas-admin.openmusk.store
# Keep the former Vercel origins during the migration window; values are comma-separated.
AUTOMATION_CUSTOMER_APP_ALLOWED_ORIGINS=https://automation-fwi.vercel.app
AUTOMATION_ADMIN_APP_ALLOWED_ORIGINS=https://n8n-automation-super-admin.vercel.app
AUTOMATION_EMAIL_DELIVERY_WEBHOOK_URL=
AUTOMATION_EMAIL_FROM=no-reply@openmusk.store
AUTOMATION_N8N_BUNDLE_VERSION=2.0.0
AUTOMATION_META_GRAPH_API_VERSION=v23.0
AUTOMATION_META_APP_ID=
# Facebook Login for Business configuration ID from Meta Developer Dashboard.
# When set, the API sends config_id and does not send a raw scope list.
AUTOMATION_META_BUSINESS_LOGIN_CONFIG_ID=
AUTOMATION_META_VERIFY_TOKEN=
AUTOMATION_META_APP_SECRET=
AUTOMATION_WORKER_CONCURRENCY=10
AUTOMATION_LOG_LEVEL=info
AUTOMATION_API_CPUS=0.75
AUTOMATION_API_MEMORY=768m
AUTOMATION_WORKER_CPUS=1.0
AUTOMATION_WORKER_MEMORY=1024m
AUTOMATION_PANEL_CPUS=0.50
AUTOMATION_PANEL_MEMORY=512m
